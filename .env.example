# Environment Configuration for Document Forgery Detection System
# Copy this to .env and customize for your setup

# Deep Learning Framework
TF_CPP_MIN_LOG_LEVEL=2  # Reduce TensorFlow logging (0=all, 1=INFO, 2=WARNING, 3=ERROR)
TF_FORCE_GPU_ALLOW_GROWTH=true
TF_ENABLE_ONEDNN_OPTS=1  # Enable Intel oneDNN optimization

# Intel GPU Optimization
ITEX_VERBOSE=0
ITEX_CPU_DEFAULT=0

# Model Configuration
MODEL_NAME=ResNet50
INPUT_SIZE=224
BATCH_SIZE=16
LEARNING_RATE=0.001

# Training Configuration
EPOCHS=30
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15
PATIENCE=5
USE_MIXED_PRECISION=true

# PDF Processing
PDF_DPI=150
PDF_MAX_PAGES=50

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_LOGGER_LEVEL=warning

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DB_NAME=forgery_detection

# Database (future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forgery_detection
DB_USER=admin
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Features
ENABLE_GPU=true
ENABLE_PDF_PROCESSING=true
ENABLE_BATCH_PROCESSING=true
ENABLE_API=true
ENABLE_STREAMLIT=true

# Security (for production)
SECRET_KEY=your-secret-key-here
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
